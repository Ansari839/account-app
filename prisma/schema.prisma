generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id String @id @default(uuid())
  code                                        String
  name                                        String
  type                                        AccountType
  parentId                                    String?
  level                                       Int                    @default(0)
  isPosting                                   Boolean                @default(true)
  createdAt                                   DateTime               @default(now())
  updatedAt DateTime @updatedAt
  deletedAt                                   DateTime?
  companyId                                   String?
  description                                 String?
  openingBalance                              Decimal                @default(0.0)
  openingBalanceType                          String?
  Company                                     Company?               @relation(fields: [companyId], references: [id])
  Account                                     Account?               @relation("AccountToAccount", fields: [parentId], references: [id])
  other_Account                               Account[]              @relation("AccountToAccount")
  AccountEntry                                AccountEntry[]
  Category                                    Category[]
  Customer                                    Customer[]
  lines JournalLine[]
  Product_Product_cogsAccountIdToAccount      Product[]              @relation("Product_cogsAccountIdToAccount")
  Product_Product_inventoryAccountIdToAccount Product[]              @relation("Product_inventoryAccountIdToAccount")
  Product_Product_purchaseAccountIdToAccount  Product[]              @relation("Product_purchaseAccountIdToAccount")
  Product_Product_salesAccountIdToAccount     Product[]              @relation("Product_salesAccountIdToAccount")
  Supplier                                    Supplier[]
  SystemAccountMapping                        SystemAccountMapping[]
  TaxCode                                     TaxCode[]

  @@unique([companyId, code])
}

model AccountEntry {
  id String @id @default(uuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0.0)
  credit        Decimal     @default(0.0)
  createdAt     DateTime    @default(now())
  updatedAt DateTime @updatedAt
  Account       Account     @relation(fields: [accountId], references: [id])
  Transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model AuditLog {
  id String @id @default(uuid())
  userId      String?
  companyId   String?
  action      String
  module      String
  entityId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  Company     Company? @relation(fields: [companyId], references: [id])
  User        User?    @relation(fields: [userId], references: [id])
}

model BOMInputItem {
  id String @id @default(uuid())
  bomId       String
  productId   String
  quantity    Decimal
  BOMTemplate BOMTemplate @relation(fields: [bomId], references: [id], onDelete: Cascade)
  Product     Product     @relation(fields: [productId], references: [id])
}

model BOMTemplate {
  id String @id @default(uuid())
  companyId       String
  outputProductId String
  outputQuantity  Decimal
  name            String
  createdAt       DateTime       @default(now())
  updatedAt DateTime @updatedAt
  BOMInputItem    BOMInputItem[]
  Company         Company        @relation(fields: [companyId], references: [id])
  Product         Product        @relation(fields: [outputProductId], references: [id])
}

model BackupApproval {
  id String @id @default(uuid())
  scheduleId     String
  logId          String?        @unique
  fromType       BackupType
  toType         BackupType
  status         ApprovalStatus @default(PENDING)
  companyId      String?
  fileCount      Int            @default(0)
  totalSizeBytes BigInt?
  requestedAt    DateTime       @default(now())
  resolvedAt     DateTime?
  BackupLog      BackupLog?     @relation(fields: [logId], references: [id])
  BackupSchedule BackupSchedule @relation(fields: [scheduleId], references: [id])
}

model BackupLog {
  id String @id @default(uuid())
  scheduleId     String?
  companyId      String?
  companyName    String?
  backupType     BackupType      @default(DAILY)
  status         BackupStatus    @default(SUCCESS)
  filePath       String?
  fileName       String?
  fileSizeBytes  BigInt?
  fileContent    String?
  errorMessage   String?
  triggeredBy    String          @default("CRON")
  createdAt      DateTime        @default(now())
  BackupApproval BackupApproval?
  BackupSchedule BackupSchedule? @relation(fields: [scheduleId], references: [id])
}

model BackupSchedule {
  id String @id @default(uuid())
  companyId       String?
  frequency       BackupFrequency  @default(DAILY)
  cronTime        String           @default("0 2 * * *")
  storagePath     String           @default("./backups")
  masterOnly      Boolean          @default(false)
  isActive        Boolean          @default(true)
  retainDaily     Int              @default(7)
  retainWeekly    Int              @default(4)
  retainMonthly   Int              @default(3)
  retainQuarterly Int              @default(4)
  createdAt       DateTime         @default(now())
  updatedAt DateTime @updatedAt
  BackupApproval  BackupApproval[]
  BackupLog       BackupLog[]
  Company         Company?         @relation(fields: [companyId], references: [id])
}

model Category {
  id String @id @default(uuid())
  name           String
  parentId       String?
  companyId      String
  createdAt      DateTime   @default(now())
  updatedAt DateTime @updatedAt
  deletedAt      DateTime?
  isService      Boolean    @default(false)
  wipAccountId   String?
  Company        Company    @relation(fields: [companyId], references: [id])
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Account        Account?   @relation(fields: [wipAccountId], references: [id])
  Product        Product[]
}

model Company {
  id String @id @default(uuid())
  name                 String
  address              String?
  phone                String?
  email                String?
  website              String?
  logo                 String?
  createdAt            DateTime               @default(now())
  updatedAt DateTime @updatedAt
  deletedAt            DateTime?
  Account              Account[]
  AuditLog             AuditLog[]
  BOMTemplate          BOMTemplate[]
  BackupSchedule       BackupSchedule[]
  Category             Category[]
  CompanySetting       CompanySetting[]
  Currency             Currency[]
  Customer             Customer[]
  DeliveryOrder        DeliveryOrder[]
  FinancialYear        FinancialYear[]
  GRN                  GRN[]
  JournalEntry         JournalEntry[]
  Product              Product[]
  ProductionRecord     ProductionRecord[]
  PurchaseInvoice      PurchaseInvoice[]
  PurchaseOrder        PurchaseOrder[]
  PurchaseRequest      PurchaseRequest[]
  PurchaseReturn       PurchaseReturn[]
  SalesInvoice         SalesInvoice[]
  SalesOrder           SalesOrder[]
  SalesQuotation       SalesQuotation[]
  SalesReturn          SalesReturn[]
  StockLedger          StockLedger[]
  Supplier             Supplier[]
  SystemAccountMapping SystemAccountMapping[]
  TaxCode              TaxCode[]
  Transaction          Transaction[]
  Unit                 Unit[]
  UnitConversion       UnitConversion[]
  User                 User[]
  UserCompany          UserCompany[]
  UserPermission       UserPermission[]
  VoucherSequence      VoucherSequence[]
  Warehouse            Warehouse[]
}

model CompanySetting {
  id String @id @default(uuid())
  companyId String
  key       String
  value     String
  type      String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model Currency {
  id String @id @default(uuid())
  code      String
  name      String
  symbol    String
  rate      Decimal    @default(1.0)
  isBase    Boolean    @default(false)
  companyId String
  createdAt DateTime   @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  Company   Company    @relation(fields: [companyId], references: [id])
  Customer  Customer[]
  Supplier  Supplier[]

  @@unique([companyId, code])
}

model Customer {
  id String @id @default(uuid())
  code                String
  name                String
  taxId               String?
  currencyCode        String
  creditLimit         Decimal          @default(0.0)
  receivableAccountId String?
  companyId           String
  createdAt           DateTime         @default(now())
  updatedAt DateTime @updatedAt
  deletedAt           DateTime?
  Company             Company          @relation(fields: [companyId], references: [id])
  Currency            Currency         @relation(fields: [currencyCode], references: [id])
  Account             Account?         @relation(fields: [receivableAccountId], references: [id])
  DeliveryOrder       DeliveryOrder[]
  SalesInvoice        SalesInvoice[]
  SalesOrder          SalesOrder[]
  SalesQuotation      SalesQuotation[]
  SalesReturn         SalesReturn[]

  @@unique([companyId, code])
}

model DeliveryOrder {
  id String @id @default(uuid())
  doNo              String
  orderId           String?
  customerId        String
  warehouseId       String
  date              DateTime
  remarks           String?
  companyId         String
  createdAt         DateTime            @default(now())
  updatedAt DateTime @updatedAt
  Company           Company             @relation(fields: [companyId], references: [id])
  Customer          Customer            @relation(fields: [customerId], references: [id])
  SalesOrder        SalesOrder?         @relation(fields: [orderId], references: [id])
  Warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  DeliveryOrderItem DeliveryOrderItem[]
  SalesInvoice      SalesInvoice[]

  @@unique([companyId, doNo])
}

model DeliveryOrderItem {
  id String @id @default(uuid())
  doId           String
  productId      String
  variantId      String?
  qty            Decimal
  soItemId       String?
  unitId         String?
  DeliveryOrder  DeliveryOrder   @relation(fields: [doId], references: [id])
  Product        Product         @relation(fields: [productId], references: [id])
  SalesOrderItem SalesOrderItem? @relation(fields: [soItemId], references: [id])
  Unit           Unit?           @relation(fields: [unitId], references: [id])
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])
}

model FinancialYear {
  id String @id @default(uuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  isOpen       Boolean        @default(false)
  openKeyHash  String?
  lockedAt     DateTime?
  companyId    String
  createdAt    DateTime       @default(now())
  updatedAt DateTime @updatedAt
  deletedAt    DateTime?
  Company      Company        @relation(fields: [companyId], references: [id])
  JournalEntry JournalEntry[]

  @@unique([companyId, name])
}

model GRN {
  id String @id @default(uuid())
  grnNo           String
  poId            String?
  supplierId      String
  warehouseId     String
  date            DateTime
  remarks         String?
  companyId       String
  createdAt       DateTime          @default(now())
  updatedAt DateTime @updatedAt
  Company         Company           @relation(fields: [companyId], references: [id])
  PurchaseOrder   PurchaseOrder?    @relation(fields: [poId], references: [id])
  Supplier        Supplier          @relation(fields: [supplierId], references: [id])
  Warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  GRNItem         GRNItem[]
  PurchaseInvoice PurchaseInvoice[]

  @@unique([companyId, grnNo])
}

model GRNItem {
  id String @id @default(uuid())
  grnId             String
  productId         String
  variantId         String?
  poItemId          String?
  qtyReceived       Decimal
  qtyRejected       Decimal            @default(0.0)
  rate              Decimal            @default(0.0)
  unitId            String?
  GRN               GRN                @relation(fields: [grnId], references: [id])
  PurchaseOrderItem PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  Product           Product            @relation(fields: [productId], references: [id])
  Unit              Unit?              @relation(fields: [unitId], references: [id])
  ProductVariant    ProductVariant?    @relation(fields: [variantId], references: [id])
}

model JournalEntry {
  id String @id @default(uuid())
  number          String
  date            DateTime
  type            VoucherType
  reference       String?
  narration       String?
  status          Boolean          @default(true)
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt DateTime @updatedAt
  financialYearId String?
  createdById     String?
  isViewed        Boolean          @default(false)
  Company         Company          @relation(fields: [companyId], references: [id])
  User            User?            @relation(fields: [createdById], references: [id])
  FinancialYear   FinancialYear?   @relation(fields: [financialYearId], references: [id])
  lines JournalLine[]
  PurchaseInvoice PurchaseInvoice?
  PurchaseReturn  PurchaseReturn?
  SalesInvoice    SalesInvoice?
  SalesReturn     SalesReturn?

  @@unique([companyId, number])
}

model JournalLine {
  id String @id @default(uuid())
  entryId      String
  accountId    String
  debit        Decimal      @default(0.0)
  credit       Decimal      @default(0.0)
  narration    String?
  Account      Account      @relation(fields: [accountId], references: [id])
  JournalEntry JournalEntry @relation(fields: [entryId], references: [id])
}

model Permission {
  id String @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, action])
}

model Product {
  id String @id @default(uuid())
  code                                        String
  name                                        String
  categoryId                                  String?
  baseUnitId                                  String
  taxCodeId                                   String?
  inventoryAccountId                          String?
  cogsAccountId                               String?
  salesAccountId                              String?
  purchaseAccountId                           String?
  canBeSold                                   Boolean               @default(true)
  canBePurchased                              Boolean               @default(true)
  isManufactured                              Boolean               @default(false)
  isService                                   Boolean               @default(false)
  openingStock                                Decimal               @default(0.0)
  companyId                                   String
  createdAt                                   DateTime              @default(now())
  updatedAt DateTime @updatedAt
  deletedAt                                   DateTime?
  hsCode                                      String?
  stage                                       ProductionStage?
  BOMInputItem                                BOMInputItem[]
  BOMTemplate                                 BOMTemplate[]
  DeliveryOrderItem                           DeliveryOrderItem[]
  GRNItem                                     GRNItem[]
  Unit                                        Unit                  @relation(fields: [baseUnitId], references: [id])
  Category                                    Category?             @relation(fields: [categoryId], references: [id])
  Account_Product_cogsAccountIdToAccount      Account?              @relation("Product_cogsAccountIdToAccount", fields: [cogsAccountId], references: [id])
  Company                                     Company               @relation(fields: [companyId], references: [id])
  Account_Product_inventoryAccountIdToAccount Account?              @relation("Product_inventoryAccountIdToAccount", fields: [inventoryAccountId], references: [id])
  Account_Product_purchaseAccountIdToAccount  Account?              @relation("Product_purchaseAccountIdToAccount", fields: [purchaseAccountId], references: [id])
  Account_Product_salesAccountIdToAccount     Account?              @relation("Product_salesAccountIdToAccount", fields: [salesAccountId], references: [id])
  TaxCode                                     TaxCode?              @relation(fields: [taxCodeId], references: [id])
  ProductVariant                              ProductVariant[]
  ProductionInput                             ProductionInput[]
  ProductionRecord                            ProductionRecord[]
  PurchaseInvoiceItem                         PurchaseInvoiceItem[]
  PurchaseOrderItem                           PurchaseOrderItem[]
  PurchaseRequestItem                         PurchaseRequestItem[]
  PurchaseReturnItem                          PurchaseReturnItem[]
  SalesInvoiceItem                            SalesInvoiceItem[]
  SalesOrderItem                              SalesOrderItem[]
  SalesQuotationItem                          SalesQuotationItem[]
  SalesReturnItem                             SalesReturnItem[]
  StockLedger                                 StockLedger[]

  @@unique([companyId, code])
}

model ProductVariant {
  id String @id @default(uuid())
  productId           String
  name                String
  sku                 String?               @unique
  price               Decimal?
  createdAt           DateTime              @default(now())
  updatedAt DateTime @updatedAt
  DeliveryOrderItem   DeliveryOrderItem[]
  GRNItem             GRNItem[]
  Product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  items PurchaseInvoiceItem[]
  PurchaseOrderItem   PurchaseOrderItem[]
  PurchaseRequestItem PurchaseRequestItem[]
  PurchaseReturnItem  PurchaseReturnItem[]
  SalesInvoiceItem    SalesInvoiceItem[]
  SalesOrderItem      SalesOrderItem[]
  SalesQuotationItem  SalesQuotationItem[]
  SalesReturnItem     SalesReturnItem[]
  StockLedger         StockLedger[]
}

model ProductionInput {
  id String @id @default(uuid())
  productionId     String
  productId        String
  quantity         Decimal
  costValue        Decimal          @default(0.0)
  lotNumber        String?
  inputStage       ProductionStage?
  Product          Product          @relation(fields: [productId], references: [id])
  ProductionRecord ProductionRecord @relation(fields: [productionId], references: [id], onDelete: Cascade)
}

model ProductionOverhead {
  id String @id @default(uuid())
  productionId          String
  description           String
  amount                Decimal
  purchaseInvoiceItemId String?
  quantity              Decimal?
  unitId                String?
  purchaseInvoiceId     String?
  ProductionRecord      ProductionRecord     @relation(fields: [productionId], references: [id], onDelete: Cascade)
  PurchaseInvoice       PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  PurchaseInvoiceItem   PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id])
  Unit                  Unit?                @relation(fields: [unitId], references: [id])
}

model ProductionRecord {
  id String @id @default(uuid())
  companyId          String
  date               DateTime
  status             String               @default("COMPLETED")
  outputProductId    String
  outputQuantity     Decimal
  warehouseId        String
  totalCost          Decimal              @default(0.0)
  createdAt          DateTime             @default(now())
  updatedAt DateTime @updatedAt
  outputStage        ProductionStage?
  ProductionInput    ProductionInput[]
  ProductionOverhead ProductionOverhead[]
  Company            Company              @relation(fields: [companyId], references: [id])
  Product            Product              @relation(fields: [outputProductId], references: [id])
  Warehouse          Warehouse            @relation(fields: [warehouseId], references: [id])
}

model PurchaseInvoice {
  id String @id @default(uuid())
  invoiceNo           String
  supplierId          String
  date                DateTime
  dueDate             DateTime?
  totalAmount         Decimal
  taxAmount           Decimal               @default(0.0)
  grnId               String?
  poId                String?
  journalEntryId      String?               @unique
  companyId           String
  createdAt           DateTime              @default(now())
  updatedAt DateTime @updatedAt
  warehouseId         String?
  discountAmount      Decimal               @default(0.0)
  discountType        String?
  hasDiscount         Boolean               @default(false)
  isImport            Boolean               @default(false)
  exchangeRate        Decimal               @default(1.0)
  foreignTotal        Decimal               @default(0.0)
  ProductionOverhead  ProductionOverhead[]
  Company             Company               @relation(fields: [companyId], references: [id])
  GRN                 GRN?                  @relation(fields: [grnId], references: [id])
  JournalEntry        JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  PurchaseOrder       PurchaseOrder?        @relation(fields: [poId], references: [id])
  Supplier            Supplier              @relation(fields: [supplierId], references: [id])
  Warehouse           Warehouse?            @relation(fields: [warehouseId], references: [id])
  items PurchaseInvoiceItem[]
  taxes PurchaseInvoiceTax[]
  PurchaseReturn      PurchaseReturn[]

  @@unique([companyId, invoiceNo])
}

model PurchaseInvoiceItem {
  id String @id @default(uuid())
  invoiceId          String
  productId          String
  variantId          String?
  qty                Decimal
  rate               Decimal
  taxCodeId          String?
  taxAmount          Decimal              @default(0.0)
  total              Decimal
  foreignRate        Decimal?
  foreignAmount      Decimal?
  isEFS              Boolean              @default(false)
  grnItemId          String?
  poItemId           String?
  unitId             String?
  consumedQty        Decimal              @default(0.0)
  ProductionOverhead ProductionOverhead[]
  PurchaseInvoice    PurchaseInvoice      @relation(fields: [invoiceId], references: [id])
  PurchaseOrderItem  PurchaseOrderItem?   @relation(fields: [poItemId], references: [id])
  Product            Product              @relation(fields: [productId], references: [id])
  TaxCode            TaxCode?             @relation(fields: [taxCodeId], references: [id])
  Unit               Unit?                @relation(fields: [unitId], references: [id])
  ProductVariant     ProductVariant?      @relation(fields: [variantId], references: [id])
  PurchaseReturnItem PurchaseReturnItem[]
}

model PurchaseInvoiceTax {
  id String @id @default(uuid())
  invoiceId       String
  taxCodeId       String?
  taxName         String
  calculation     String          @default("NET_TOTAL")
  rate            Decimal
  baseAmount      Decimal
  taxAmount       Decimal
  isCapitalized   Boolean         @default(false)
  PurchaseInvoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  TaxCode         TaxCode?        @relation(fields: [taxCodeId], references: [id])
}

model PurchaseOrder {
  id String @id @default(uuid())
  poNo              String
  supplierId        String
  warehouseId       String?
  date              DateTime
  expectedDate      DateTime?
  totalAmount       Decimal             @default(0.0)
  status            String              @default("DRAFT")
  companyId         String
  createdAt         DateTime            @default(now())
  updatedAt DateTime @updatedAt
  GRN               GRN[]
  PurchaseInvoice   PurchaseInvoice[]
  Company           Company             @relation(fields: [companyId], references: [id])
  Supplier          Supplier            @relation(fields: [supplierId], references: [id])
  Warehouse         Warehouse?          @relation(fields: [warehouseId], references: [id])
  items PurchaseOrderItem[]
  PurchaseReturn    PurchaseReturn[]

  @@unique([companyId, poNo])
}

model PurchaseOrderItem {
  id String @id @default(uuid())
  poId                String
  productId           String
  variantId           String?
  qty                 Decimal
  rate                Decimal
  taxCodeId           String?
  taxAmount           Decimal               @default(0.0)
  total               Decimal
  invoicedQty         Decimal               @default(0.0)
  receivedQty         Decimal               @default(0.0)
  unitId              String?
  GRNItem             GRNItem[]
  items PurchaseInvoiceItem[]
  PurchaseOrder       PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)
  Product             Product               @relation(fields: [productId], references: [id])
  TaxCode             TaxCode?              @relation(fields: [taxCodeId], references: [id])
  Unit                Unit?                 @relation(fields: [unitId], references: [id])
  ProductVariant      ProductVariant?       @relation(fields: [variantId], references: [id])
}

model PurchaseRequest {
  id String @id @default(uuid())
  reqNo               String
  date                DateTime
  status              String                @default("DRAFT")
  remarks             String?
  companyId           String
  createdAt           DateTime              @default(now())
  updatedAt DateTime @updatedAt
  Company             Company               @relation(fields: [companyId], references: [id])
  PurchaseRequestItem PurchaseRequestItem[]

  @@unique([companyId, reqNo])
}

model PurchaseRequestItem {
  id String @id @default(uuid())
  requestId       String
  productId       String
  variantId       String?
  qty             Decimal
  description     String?
  Product         Product         @relation(fields: [productId], references: [id])
  PurchaseRequest PurchaseRequest @relation(fields: [requestId], references: [id])
  ProductVariant  ProductVariant? @relation(fields: [variantId], references: [id])
}

model PurchaseReturn {
  id String @id @default(uuid())
  returnNo           String
  poId               String?
  invoiceId          String?
  supplierId         String
  warehouseId        String
  date               DateTime
  totalAmount        Decimal              @default(0.0)
  journalEntryId     String?              @unique
  remarks            String?
  companyId          String
  createdAt          DateTime             @default(now())
  updatedAt DateTime @updatedAt
  discountAmount     Decimal              @default(0.0)
  discountType       String?
  hasDiscount        Boolean              @default(false)
  Company            Company              @relation(fields: [companyId], references: [id])
  PurchaseInvoice    PurchaseInvoice?     @relation(fields: [invoiceId], references: [id])
  JournalEntry       JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  PurchaseOrder      PurchaseOrder?       @relation(fields: [poId], references: [id])
  Supplier           Supplier             @relation(fields: [supplierId], references: [id])
  Warehouse          Warehouse            @relation(fields: [warehouseId], references: [id])
  PurchaseReturnItem PurchaseReturnItem[]

  @@unique([companyId, returnNo])
}

model PurchaseReturnItem {
  id String @id @default(uuid())
  returnId            String
  productId           String
  variantId           String?
  invoiceItemId       String?
  qty                 Decimal
  rate                Decimal
  taxCodeId           String?
  taxAmount           Decimal              @default(0.0)
  total               Decimal
  unitId              String?
  PurchaseInvoiceItem PurchaseInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  Product             Product              @relation(fields: [productId], references: [id])
  PurchaseReturn      PurchaseReturn       @relation(fields: [returnId], references: [id])
  TaxCode             TaxCode?             @relation(fields: [taxCodeId], references: [id])
  Unit                Unit?                @relation(fields: [unitId], references: [id])
  ProductVariant      ProductVariant?      @relation(fields: [variantId], references: [id])
}

model SalesInvoice {
  id String @id @default(uuid())
  invoiceNo        String
  customerId       String
  warehouseId      String?
  date             DateTime
  dueDate          DateTime?
  totalAmount      Decimal
  taxAmount        Decimal            @default(0.0)
  doId             String?
  journalEntryId   String?            @unique
  companyId        String
  createdAt        DateTime           @default(now())
  updatedAt DateTime @updatedAt
  orderId          String?
  discountAmount   Decimal            @default(0.0)
  discountType     String?
  hasDiscount      Boolean            @default(false)
  isExport         Boolean            @default(false)
  exchangeRate     Decimal            @default(1.0)
  foreignTotal     Decimal            @default(0.0)
  Company          Company            @relation(fields: [companyId], references: [id])
  Customer         Customer           @relation(fields: [customerId], references: [id])
  DeliveryOrder    DeliveryOrder?     @relation(fields: [doId], references: [id])
  JournalEntry     JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  SalesOrder       SalesOrder?        @relation(fields: [orderId], references: [id])
  Warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id])
  SalesInvoiceItem SalesInvoiceItem[]
  SalesInvoiceTax  SalesInvoiceTax[]
  SalesReturn      SalesReturn[]

  @@unique([companyId, invoiceNo])
}

model SalesInvoiceItem {
  id String @id @default(uuid())
  invoiceId       String
  productId       String
  variantId       String?
  qty             Decimal
  rate            Decimal
  taxCodeId       String?
  taxAmount       Decimal           @default(0.0)
  total           Decimal
  foreignRate     Decimal?
  foreignAmount   Decimal?
  isEFS           Boolean           @default(false)
  doItemId        String?
  soItemId        String?
  unitId          String?
  SalesInvoice    SalesInvoice      @relation(fields: [invoiceId], references: [id])
  Product         Product           @relation(fields: [productId], references: [id])
  SalesOrderItem  SalesOrderItem?   @relation(fields: [soItemId], references: [id])
  TaxCode         TaxCode?          @relation(fields: [taxCodeId], references: [id])
  Unit            Unit?             @relation(fields: [unitId], references: [id])
  ProductVariant  ProductVariant?   @relation(fields: [variantId], references: [id])
  SalesReturnItem SalesReturnItem[]
}

model SalesInvoiceTax {
  id String @id @default(uuid())
  invoiceId    String
  taxCodeId    String?
  taxName      String
  calculation  String       @default("NET_TOTAL")
  rate         Decimal
  baseAmount   Decimal
  taxAmount    Decimal
  SalesInvoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  TaxCode      TaxCode?     @relation(fields: [taxCodeId], references: [id])
}

model SalesOrder {
  id String @id @default(uuid())
  orderNo        String
  customerId     String
  warehouseId    String?
  date           DateTime
  expectedDate   DateTime?
  totalAmount    Decimal          @default(0.0)
  status         String           @default("DRAFT")
  quoteId        String?
  companyId      String
  createdAt      DateTime         @default(now())
  updatedAt DateTime @updatedAt
  DeliveryOrder  DeliveryOrder[]
  SalesInvoice   SalesInvoice[]
  Company        Company          @relation(fields: [companyId], references: [id])
  Customer       Customer         @relation(fields: [customerId], references: [id])
  SalesQuotation SalesQuotation?  @relation(fields: [quoteId], references: [id])
  Warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id])
  SalesOrderItem SalesOrderItem[]

  @@unique([companyId, orderNo])
}

model SalesOrderItem {
  id String @id @default(uuid())
  orderId           String
  productId         String
  variantId         String?
  qty               Decimal
  rate              Decimal
  taxCodeId         String?
  taxAmount         Decimal             @default(0.0)
  total             Decimal
  fulfilledQty      Decimal             @default(0.0)
  invoicedQty       Decimal             @default(0.0)
  unitId            String?
  DeliveryOrderItem DeliveryOrderItem[]
  SalesInvoiceItem  SalesInvoiceItem[]
  SalesOrder        SalesOrder          @relation(fields: [orderId], references: [id])
  Product           Product             @relation(fields: [productId], references: [id])
  TaxCode           TaxCode?            @relation(fields: [taxCodeId], references: [id])
  Unit              Unit?               @relation(fields: [unitId], references: [id])
  ProductVariant    ProductVariant?     @relation(fields: [variantId], references: [id])
}

model SalesQuotation {
  id String @id @default(uuid())
  quoteNo            String
  customerId         String
  date               DateTime
  validUntil         DateTime?
  totalAmount        Decimal              @default(0.0)
  status             String               @default("DRAFT")
  companyId          String
  createdAt          DateTime             @default(now())
  updatedAt DateTime @updatedAt
  SalesOrder         SalesOrder[]
  Company            Company              @relation(fields: [companyId], references: [id])
  Customer           Customer             @relation(fields: [customerId], references: [id])
  SalesQuotationItem SalesQuotationItem[]

  @@unique([companyId, quoteNo])
}

model SalesQuotationItem {
  id String @id @default(uuid())
  quoteId        String
  productId      String
  variantId      String?
  qty            Decimal
  rate           Decimal
  taxCodeId      String?
  taxAmount      Decimal         @default(0.0)
  total          Decimal
  unitId         String?
  Product        Product         @relation(fields: [productId], references: [id])
  SalesQuotation SalesQuotation  @relation(fields: [quoteId], references: [id])
  TaxCode        TaxCode?        @relation(fields: [taxCodeId], references: [id])
  Unit           Unit?           @relation(fields: [unitId], references: [id])
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])
}

model SalesReturn {
  id String @id @default(uuid())
  returnNo        String
  invoiceId       String?
  customerId      String
  date            DateTime
  totalAmount     Decimal           @default(0.0)
  journalEntryId  String?           @unique
  remarks         String?
  companyId       String
  createdAt       DateTime          @default(now())
  updatedAt DateTime @updatedAt
  warehouseId     String
  discountAmount  Decimal           @default(0.0)
  discountType    String?
  hasDiscount     Boolean           @default(false)
  Company         Company           @relation(fields: [companyId], references: [id])
  Customer        Customer          @relation(fields: [customerId], references: [id])
  SalesInvoice    SalesInvoice?     @relation(fields: [invoiceId], references: [id])
  JournalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  Warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  SalesReturnItem SalesReturnItem[]

  @@unique([companyId, returnNo])
}

model SalesReturnItem {
  id String @id @default(uuid())
  returnId         String
  productId        String
  variantId        String?
  qty              Decimal
  rate             Decimal
  taxCodeId        String?
  taxAmount        Decimal           @default(0.0)
  total            Decimal
  invoiceItemId    String?
  unitId           String?
  SalesInvoiceItem SalesInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  Product          Product           @relation(fields: [productId], references: [id])
  SalesReturn      SalesReturn       @relation(fields: [returnId], references: [id])
  TaxCode          TaxCode?          @relation(fields: [taxCodeId], references: [id])
  Unit             Unit?             @relation(fields: [unitId], references: [id])
  ProductVariant   ProductVariant?   @relation(fields: [variantId], references: [id])
}

model StockLedger {
  id String @id @default(uuid())
  productId      String
  warehouseId    String
  date           DateTime
  qtyIn          Decimal          @default(0.0)
  qtyOut         Decimal          @default(0.0)
  costRate       Decimal          @default(0.0)
  refType        String
  refId          String
  companyId      String
  isEFS          Boolean          @default(false)
  createdAt      DateTime         @default(now())
  variantId      String?
  stage          ProductionStage? @default(RAW)
  Company        Company          @relation(fields: [companyId], references: [id])
  Product        Product          @relation(fields: [productId], references: [id])
  ProductVariant ProductVariant?  @relation(fields: [variantId], references: [id])
  Warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])
}

model Supplier {
  id String @id @default(uuid())
  code             String
  name             String
  taxId            String?
  currencyCode     String
  payableAccountId String?
  companyId        String
  createdAt        DateTime          @default(now())
  updatedAt DateTime @updatedAt
  deletedAt        DateTime?
  GRN              GRN[]
  PurchaseInvoice  PurchaseInvoice[]
  PurchaseOrder    PurchaseOrder[]
  PurchaseReturn   PurchaseReturn[]
  Company          Company           @relation(fields: [companyId], references: [id])
  Currency         Currency          @relation(fields: [currencyCode], references: [id])
  Account          Account?          @relation(fields: [payableAccountId], references: [id])

  @@unique([companyId, code])
}

model SystemAccountMapping {
  id String @id @default(uuid())
  companyId String
  key       String
  accountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Account   Account  @relation(fields: [accountId], references: [id])
  Company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model TaxCode {
  id String @id @default(uuid())
  name                String
  code                String
  rate                Decimal               @default(0.0)
  companyId           String
  createdAt           DateTime              @default(now())
  updatedAt DateTime @updatedAt
  deletedAt           DateTime?
  accountId           String?
  Product             Product[]
  items PurchaseInvoiceItem[]
  taxes PurchaseInvoiceTax[]
  PurchaseOrderItem   PurchaseOrderItem[]
  PurchaseReturnItem  PurchaseReturnItem[]
  SalesInvoiceItem    SalesInvoiceItem[]
  SalesInvoiceTax     SalesInvoiceTax[]
  SalesOrderItem      SalesOrderItem[]
  SalesQuotationItem  SalesQuotationItem[]
  SalesReturnItem     SalesReturnItem[]
  Account             Account?              @relation(fields: [accountId], references: [id])
  Company             Company               @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Transaction {
  id String @id @default(uuid())
  reference    String
  date         DateTime       @default(now())
  description  String?
  type         String         @default("JOURNAL")
  invoiceId    String?
  paymentId    String?
  purchaseId   String?
  companyId    String
  createdAt    DateTime       @default(now())
  updatedAt DateTime @updatedAt
  isLocked     Boolean        @default(false)
  AccountEntry AccountEntry[]
  Company      Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
}

model Unit {
  id String @id @default(uuid())
  name                                           String
  code                                           String
  companyId                                      String
  createdAt                                      DateTime              @default(now())
  updatedAt DateTime @updatedAt
  deletedAt                                      DateTime?
  DeliveryOrderItem                              DeliveryOrderItem[]
  GRNItem                                        GRNItem[]
  Product                                        Product[]
  ProductionOverhead                             ProductionOverhead[]
  PurchaseInvoiceItem                            PurchaseInvoiceItem[]
  PurchaseOrderItem                              PurchaseOrderItem[]
  PurchaseReturnItem                             PurchaseReturnItem[]
  SalesInvoiceItem                               SalesInvoiceItem[]
  SalesOrderItem                                 SalesOrderItem[]
  SalesQuotationItem                             SalesQuotationItem[]
  SalesReturnItem                                SalesReturnItem[]
  Company                                        Company               @relation(fields: [companyId], references: [id])
  UnitConversion_UnitConversion_fromUnitIdToUnit UnitConversion[]      @relation("UnitConversion_fromUnitIdToUnit")
  UnitConversion_UnitConversion_toUnitIdToUnit   UnitConversion[]      @relation("UnitConversion_toUnitIdToUnit")

  @@unique([companyId, code])
}

model UnitConversion {
  id String @id @default(uuid())
  fromUnitId                           String
  toUnitId                             String
  factor                               Decimal
  companyId                            String
  createdAt                            DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company                              Company  @relation(fields: [companyId], references: [id])
  Unit_UnitConversion_fromUnitIdToUnit Unit     @relation("UnitConversion_fromUnitIdToUnit", fields: [fromUnitId], references: [id])
  Unit_UnitConversion_toUnitIdToUnit   Unit     @relation("UnitConversion_toUnitIdToUnit", fields: [toUnitId], references: [id])
}

model User {
  id String @id @default(uuid())
  email          String           @unique
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  fullName       String?
  isActive       Boolean          @default(true)
  isSuperAdmin   Boolean          @default(false)
  lastLoginAt    DateTime?
  mustChangePass Boolean          @default(true)
  passwordHash   String
  phone          String?
  updatedAt DateTime @updatedAt
  companyId      String?
  AuditLog       AuditLog[]
  JournalEntry   JournalEntry[]
  Company        Company?         @relation(fields: [companyId], references: [id])
  UserCompany    UserCompany[]
  UserPermission UserPermission[]
}

model UserCompany {
  id String @id @default(uuid())
  userId    String
  companyId String
  role      String   @default("USER")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company   Company  @relation(fields: [companyId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
}

model UserPermission {
  id String @id @default(uuid())
  userId         String
  companyId      String
  module         String
  canRead        Boolean  @default(false)
  canWrite       Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canViewFinance Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company        Company  @relation(fields: [companyId], references: [id])
  User           User     @relation(fields: [userId], references: [id])

  @@unique([userId, companyId, module])
}

model UserRoleLimit {
  id String @id @default(uuid())
  userId     String
  module     String
  limitType  String
  limitValue String
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherSequence {
  id String @id @default(uuid())
  type      VoucherType
  prefix    String
  nextValue Int         @default(1)
  companyId String
  updatedAt DateTime @updatedAt
  Company   Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, type])
}

model Warehouse {
  id String @id @default(uuid())
  code             String
  name             String
  address          String?
  isDefault        Boolean            @default(false)
  companyId        String
  createdAt        DateTime           @default(now())
  updatedAt DateTime @updatedAt
  deletedAt        DateTime?
  DeliveryOrder    DeliveryOrder[]
  GRN              GRN[]
  ProductionRecord ProductionRecord[]
  PurchaseInvoice  PurchaseInvoice[]
  PurchaseOrder    PurchaseOrder[]
  PurchaseReturn   PurchaseReturn[]
  SalesInvoice     SalesInvoice[]
  SalesOrder       SalesOrder[]
  SalesReturn      SalesReturn[]
  StockLedger      StockLedger[]
  Company          Company            @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BackupFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

enum BackupType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BalanceType {
  DR
  CR
}

enum ProductionStage {
  RAW
  GREY
  FINISH
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  PURCHASE
  SALES
  CONTRA
  PURCHASE_RETURN
  SALES_RETURN
  OPENING
  CLOSING
}
