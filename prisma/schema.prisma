generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String        @id @default(uuid())
  name         String
  address      String?
  phone        String?
  email        String?
  website      String?
  logo         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  accounts     Account[]
  transactions Transaction[]
  users        User[]
}

model FinancialYear {
  id             String         @id @default(uuid())
  name           String         @unique
  startDate      DateTime
  endDate        DateTime
  isOpen         Boolean        @default(false)
  openKeyHash    String?
  lockedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  journalEntries JournalEntry[]
}

model Currency {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  symbol    String
  rate      Decimal    @default(1.0)
  isBase    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  customers Customer[]
  suppliers Supplier[]
}

model Unit {
  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  products        Product[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  poItems         PurchaseOrderItem[]
  grnItems        GRNItem[]
  invoiceItems    PurchaseInvoiceItem[]
  returnItems     PurchaseReturnItem[]
  salesQuoteItems SalesQuotationItem[]
  salesOrderItems SalesOrderItem[]
  doItems         DeliveryOrderItem[]
  salesInvItems   SalesInvoiceItem[]
  salesRetItems   SalesReturnItem[]
}

model TaxCode {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  rate                 Decimal               @default(0.0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  accountId            String?
  products             Product[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesOrderItems      SalesOrderItem[]
  salesQuotationItems  SalesQuotationItem[]
  salesReturnItems     SalesReturnItem[]
  account              Account?              @relation("TaxAccount", fields: [accountId], references: [id])
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  createdAt      DateTime   @default(now())
  deletedAt      DateTime?
  fullName       String?
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  mustChangePass Boolean    @default(true)
  passwordHash   String
  phone          String?
  updatedAt      DateTime   @updatedAt
  companyId      String?
  auditLogs      AuditLog[]
  company        Company?   @relation(fields: [companyId], references: [id])
  roles          UserRole[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRoleLimit {
  id         String   @id @default(uuid())
  userId     String
  module     String
  limitType  String
  limitValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  module      String
  entityId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Account {
  id                  String         @id @default(uuid())
  code                String
  name                String
  type                AccountType
  parentId            String?
  level               Int            @default(0)
  isPosting           Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  companyId           String?
  description         String?
  openingBalance      Decimal        @default(0.0)
  openingBalanceType  String?
  company             Company?       @relation(fields: [companyId], references: [id])
  parent              Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children            Account[]      @relation("AccountHierarchy")
  entries             AccountEntry[]
  customersReceivable Customer[]     @relation("ReceivableAccount")
  journalLines        JournalLine[]
  productsCOGS        Product[]      @relation("COGSAccount")
  productsInventory   Product[]      @relation("InventoryAccount")
  productsPurchase    Product[]      @relation("PurchaseAccount")
  productsSales       Product[]      @relation("SalesAccount")
  suppliersPayable    Supplier[]     @relation("PayableAccount")
  taxCodes            TaxCode[]      @relation("TaxAccount")

  @@unique([companyId, code])
}

model Transaction {
  id          String         @id @default(uuid())
  reference   String
  date        DateTime       @default(now())
  description String?
  type        String         @default("JOURNAL")
  invoiceId   String?
  paymentId   String?
  purchaseId  String?
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isLocked    Boolean        @default(false)
  entries     AccountEntry[]
  company     Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
}

model AccountEntry {
  id            String      @id @default(uuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0.0)
  credit        Decimal     @default(0.0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model Customer {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  taxId               String?
  currencyCode        String
  creditLimit         Decimal          @default(0.0)
  receivableAccountId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  currency            Currency         @relation(fields: [currencyCode], references: [code])
  receivableAccount   Account?         @relation("ReceivableAccount", fields: [receivableAccountId], references: [id])
  deliveryOrders      DeliveryOrder[]
  invoices            SalesInvoice[]
  orders              SalesOrder[]
  quotes              SalesQuotation[]
  returns             SalesReturn[]
}

model Supplier {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  taxId            String?
  currencyCode     String
  payableAccountId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  grns             GRN[]
  invoices         PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  returns          PurchaseReturn[]
  currency         Currency          @relation(fields: [currencyCode], references: [code])
  payableAccount   Account?          @relation("PayableAccount", fields: [payableAccountId], references: [id])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Product {
  id                  String                @id @default(uuid())
  code                String                @unique
  name                String
  categoryId          String?
  baseUnitId          String
  taxCodeId           String?
  inventoryAccountId  String?
  cogsAccountId       String?
  salesAccountId      String?
  purchaseAccountId   String?
  openingStock        Decimal               @default(0.0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  doItems             DeliveryOrderItem[]
  grnItems            GRNItem[]
  baseUnit            Unit                  @relation(fields: [baseUnitId], references: [id])
  category            Category?             @relation(fields: [categoryId], references: [id])
  cogsAccount         Account?              @relation("COGSAccount", fields: [cogsAccountId], references: [id])
  inventoryAccount    Account?              @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  purchaseAccount     Account?              @relation("PurchaseAccount", fields: [purchaseAccountId], references: [id])
  salesAccount        Account?              @relation("SalesAccount", fields: [salesAccountId], references: [id])
  taxCode             TaxCode?              @relation(fields: [taxCodeId], references: [id])
  variants            ProductVariant[]
  invoiceItems        PurchaseInvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  requestItems        PurchaseRequestItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  orderItems          SalesOrderItem[]
  quoteItems          SalesQuotationItem[]
  returnItems         SalesReturnItem[]
  stockEntries        StockLedger[]
}

model ProductVariant {
  id           String        @id @default(uuid())
  productId    String
  name         String
  sku          String?       @unique
  price        Decimal?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockEntries StockLedger[]
}

model Warehouse {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  address          String?
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deliveryOrders   DeliveryOrder[]
  grns             GRN[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  salesInvoices    SalesInvoice[]
  salesOrders      SalesOrder[]
  salesReturns     SalesReturn[]
  stockEntries     StockLedger[]
}

model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fromUnit   Unit     @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit     @relation("ToUnit", fields: [toUnitId], references: [id])
}

model JournalEntry {
  id              String           @id @default(uuid())
  number          String           @unique
  date            DateTime
  type            VoucherType
  reference       String?
  narration       String?
  status          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  financialYearId String?
  financialYear   FinancialYear?   @relation(fields: [financialYearId], references: [id])
  lines           JournalLine[]
  purchaseInvoice PurchaseInvoice?
  purchaseReturn  PurchaseReturn?
  salesInvoice    SalesInvoice?
  salesReturn     SalesReturn?
}

model JournalLine {
  id        String       @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal      @default(0.0)
  credit    Decimal      @default(0.0)
  narration String?
  account   Account      @relation(fields: [accountId], references: [id])
  entry     JournalEntry @relation(fields: [entryId], references: [id])
}

model StockLedger {
  id          String          @id @default(uuid())
  productId   String
  warehouseId String
  date        DateTime
  qtyIn       Decimal         @default(0.0)
  qtyOut      Decimal         @default(0.0)
  costRate    Decimal         @default(0.0)
  refType     String
  refId       String
  createdAt   DateTime        @default(now())
  variantId   String?
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNo         String              @unique
  supplierId   String
  warehouseId  String?
  date         DateTime
  expectedDate DateTime?
  totalAmount  Decimal             @default(0.0)
  status       String              @default("DRAFT")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  grns         GRN[]
  invoices     PurchaseInvoice[]
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse?          @relation(fields: [warehouseId], references: [id])
  items        PurchaseOrderItem[]
  returns      PurchaseReturn[]
}

model PurchaseReturn {
  id             String               @id @default(uuid())
  returnNo       String               @unique
  poId           String?
  invoiceId      String?
  supplierId     String
  warehouseId    String
  date           DateTime
  totalAmount    Decimal              @default(0.0)
  journalEntryId String?              @unique
  remarks        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  invoice        PurchaseInvoice?     @relation(fields: [invoiceId], references: [id])
  journalEntry   JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  po             PurchaseOrder?       @relation(fields: [poId], references: [id])
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  items          PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id            String               @id @default(uuid())
  returnId      String
  productId     String
  invoiceItemId String?
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal              @default(0.0)
  total         Decimal
  invoiceItem   PurchaseInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  unitId        String?
  product       Product              @relation(fields: [productId], references: [id])
  return        PurchaseReturn       @relation(fields: [returnId], references: [id])
  taxCode       TaxCode?             @relation(fields: [taxCodeId], references: [id])
  unit          Unit?                @relation(fields: [unitId], references: [id])
}

model PurchaseOrderItem {
  id           String                @id @default(uuid())
  poId         String
  productId    String
  qty          Decimal
  rate         Decimal
  taxCodeId    String?
  taxAmount    Decimal               @default(0.0)
  total        Decimal
  invoicedQty  Decimal               @default(0.0)
  receivedQty  Decimal               @default(0.0)
  grnItems     GRNItem[]
  invoiceItems PurchaseInvoiceItem[]
  unitId       String?
  po           PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  taxCode      TaxCode?              @relation(fields: [taxCodeId], references: [id])
  unit         Unit?                 @relation(fields: [unitId], references: [id])
}

model GRN {
  id          String            @id @default(uuid())
  grnNo       String            @unique
  poId        String?
  supplierId  String
  warehouseId String
  date        DateTime
  remarks     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  po          PurchaseOrder?    @relation(fields: [poId], references: [id])
  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  items       GRNItem[]
  invoices    PurchaseInvoice[]
}

model GRNItem {
  id          String             @id @default(uuid())
  grnId       String
  productId   String
  poItemId    String?
  qtyReceived Decimal
  qtyRejected Decimal            @default(0.0)
  rate        Decimal            @default(0.0)
  unitId      String?
  grn         GRN                @relation(fields: [grnId], references: [id])
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  product     Product            @relation(fields: [productId], references: [id])
  unit        Unit?              @relation(fields: [unitId], references: [id])
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  invoiceNo      String                @unique
  supplierId     String
  date           DateTime
  dueDate        DateTime?
  totalAmount    Decimal
  taxAmount      Decimal               @default(0.0)
  grnId          String?
  poId           String?
  journalEntryId String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  warehouseId    String?
  grn            GRN?                  @relation(fields: [grnId], references: [id])
  journalEntry   JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  po             PurchaseOrder?        @relation(fields: [poId], references: [id])
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse?            @relation(fields: [warehouseId], references: [id])
  items          PurchaseInvoiceItem[]
  returns        PurchaseReturn[]
}

model PurchaseInvoiceItem {
  id          String               @id @default(uuid())
  invoiceId   String
  productId   String
  qty         Decimal
  rate        Decimal
  taxCodeId   String?
  taxAmount   Decimal              @default(0.0)
  total       Decimal
  grnItemId   String?
  poItemId    String?
  unitId      String?
  invoice     PurchaseInvoice      @relation(fields: [invoiceId], references: [id])
  poItem      PurchaseOrderItem?   @relation(fields: [poItemId], references: [id])
  product     Product              @relation(fields: [productId], references: [id])
  taxCode     TaxCode?             @relation(fields: [taxCodeId], references: [id])
  returnItems PurchaseReturnItem[]
  unit        Unit?                @relation(fields: [unitId], references: [id])
}

model PurchaseRequest {
  id        String                @id @default(uuid())
  reqNo     String                @unique
  date      DateTime
  status    String                @default("DRAFT")
  remarks   String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     PurchaseRequestItem[]
}

model PurchaseRequestItem {
  id          String          @id @default(uuid())
  requestId   String
  productId   String
  qty         Decimal
  description String?
  product     Product         @relation(fields: [productId], references: [id])
  request     PurchaseRequest @relation(fields: [requestId], references: [id])
}

model SalesQuotation {
  id          String               @id @default(uuid())
  quoteNo     String               @unique
  customerId  String
  date        DateTime
  validUntil  DateTime?
  totalAmount Decimal              @default(0.0)
  status      String               @default("DRAFT")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  orders      SalesOrder[]
  customer    Customer             @relation(fields: [customerId], references: [id])
  items       SalesQuotationItem[]
}

model SalesQuotationItem {
  id        String         @id @default(uuid())
  quoteId   String
  productId String
  qty       Decimal
  rate      Decimal
  taxCodeId String?
  taxAmount Decimal        @default(0.0)
  total     Decimal
  unitId    String?
  unit      Unit?          @relation(fields: [unitId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  quote     SalesQuotation @relation(fields: [quoteId], references: [id])
  taxCode   TaxCode?       @relation(fields: [taxCodeId], references: [id])
}

model SalesOrder {
  id             String           @id @default(uuid())
  orderNo        String           @unique
  customerId     String
  warehouseId    String?
  date           DateTime
  expectedDate   DateTime?
  totalAmount    Decimal          @default(0.0)
  status         String           @default("DRAFT")
  quoteId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deliveryOrders DeliveryOrder[]
  invoices       SalesInvoice[]
  customer       Customer         @relation(fields: [customerId], references: [id])
  quote          SalesQuotation?  @relation(fields: [quoteId], references: [id])
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id])
  items          SalesOrderItem[]
}

model SalesOrderItem {
  id           String              @id @default(uuid())
  orderId      String
  productId    String
  qty          Decimal
  rate         Decimal
  taxCodeId    String?
  taxAmount    Decimal             @default(0.0)
  total        Decimal
  fulfilledQty Decimal             @default(0.0)
  invoicedQty  Decimal             @default(0.0)
  doItems      DeliveryOrderItem[]
  invoiceItems SalesInvoiceItem[]
  unitId       String?
  unit         Unit?               @relation(fields: [unitId], references: [id])
  order        SalesOrder          @relation(fields: [orderId], references: [id])
  product      Product             @relation(fields: [productId], references: [id])
  taxCode      TaxCode?            @relation(fields: [taxCodeId], references: [id])
}

model DeliveryOrder {
  id          String              @id @default(uuid())
  doNo        String              @unique
  orderId     String?
  customerId  String
  warehouseId String
  date        DateTime
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  customer    Customer            @relation(fields: [customerId], references: [id])
  order       SalesOrder?         @relation(fields: [orderId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       DeliveryOrderItem[]
  invoices    SalesInvoice[]
}

model DeliveryOrderItem {
  id        String          @id @default(uuid())
  doId      String
  productId String
  qty       Decimal
  soItemId  String?
  unitId    String?
  unit      Unit?           @relation(fields: [unitId], references: [id])
  do        DeliveryOrder   @relation(fields: [doId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  soItem    SalesOrderItem? @relation(fields: [soItemId], references: [id])
}

model SalesInvoice {
  id             String             @id @default(uuid())
  invoiceNo      String             @unique
  customerId     String
  warehouseId    String?
  date           DateTime
  dueDate        DateTime?
  totalAmount    Decimal
  taxAmount      Decimal            @default(0.0)
  doId           String?
  journalEntryId String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  orderId        String?
  customer       Customer           @relation(fields: [customerId], references: [id])
  do             DeliveryOrder?     @relation(fields: [doId], references: [id])
  journalEntry   JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  order          SalesOrder?        @relation(fields: [orderId], references: [id])
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id])
  items          SalesInvoiceItem[]
  returns        SalesReturn[]
}

model SalesInvoiceItem {
  id          String            @id @default(uuid())
  invoiceId   String
  productId   String
  qty         Decimal
  rate        Decimal
  taxCodeId   String?
  taxAmount   Decimal           @default(0.0)
  total       Decimal
  doItemId    String?
  soItemId    String?
  unitId      String?
  unit        Unit?             @relation(fields: [unitId], references: [id])
  invoice     SalesInvoice      @relation(fields: [invoiceId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  soItem      SalesOrderItem?   @relation(fields: [soItemId], references: [id])
  taxCode     TaxCode?          @relation(fields: [taxCodeId], references: [id])
  returnItems SalesReturnItem[]
}

model SalesReturn {
  id             String            @id @default(uuid())
  returnNo       String            @unique
  invoiceId      String?
  customerId     String
  date           DateTime
  totalAmount    Decimal           @default(0.0)
  journalEntryId String?           @unique
  remarks        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  warehouseId    String
  customer       Customer          @relation(fields: [customerId], references: [id])
  invoice        SalesInvoice?     @relation(fields: [invoiceId], references: [id])
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  items          SalesReturnItem[]
}

model SalesReturnItem {
  id            String            @id @default(uuid())
  returnId      String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal           @default(0.0)
  total         Decimal
  invoiceItemId String?
  unitId        String?
  unit          Unit?             @relation(fields: [unitId], references: [id])
  invoiceItem   SalesInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  return        SalesReturn       @relation(fields: [returnId], references: [id])
  taxCode       TaxCode?          @relation(fields: [taxCodeId], references: [id])
}

model VoucherSequence {
  id        String      @id @default(uuid())
  type      VoucherType @unique
  prefix    String
  nextValue Int         @default(1)
  updatedAt DateTime    @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BalanceType {
  DR
  CR
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  PURCHASE
  SALES
  CONTRA
  PURCHASE_RETURN
  SALES_RETURN
  OPENING
  CLOSING
}
