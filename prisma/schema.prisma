generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// 0.2 Core Database Foundations: Master Tables
// --------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  
  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? 
}

model FinancialYear {
  id          String   @id @default(uuid())
  name        String   // e.g., "FY 2024-25"
  startDate   DateTime
  endDate     DateTime
  isOpen      Boolean  @default(false)
  openKeyHash String?  // Hashed key required to open year
  lockedAt    DateTime? // Permanently locked timestamp

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  journalEntries JournalEntry[]
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique // USD, EUR
  name      String
  symbol    String
  rate      Decimal  @default(1.0) // Exchange rate to base currency
  isBase    Boolean  @default(false)
  
  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  customers Customer[]
  suppliers Supplier[]
}

model Unit {
  id        String   @id @default(uuid())
  name      String   // Kg, Pcs, Box
  code      String   @unique
  
  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  products        Product[]
}

model TaxCode {
  id        String   @id @default(uuid())
  name      String   // VAT 5%, GST 18%
  code      String   @unique
  rate      Decimal  @default(0.0)
  accountId String?  // Link to Tax Account (e.g. Input VAT)
  
  account   Account? @relation("TaxAccount", fields: [accountId], references: [id])
  
  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  products       Product[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems   PurchaseInvoiceItem[]

  salesQuotationItems SalesQuotationItem[]
  salesOrderItems     SalesOrderItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  salesReturnItems    SalesReturnItem[]
}

// --------------------------------------
// 0.3 Auth System (RBAC + ABAC) & Security Tables
// --------------------------------------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String?
  phone          String?
  isActive       Boolean   @default(true)
  mustChangePass Boolean   @default(true) // Force password change on first login
  lastLoginAt    DateTime?
  
  // Relations
  roles          UserRole[]
  auditLogs      AuditLog[]

  // Audit Fields
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, MANAGER, ACCOUNTANT
  description String?
  
  // Relations
  users       UserRole[]
  permissions RolePermission[]

  // Audit Fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
}

model Permission {
  id          String   @id @default(uuid())
  module      String   // INVOICE, USER, REPORT
  action      String   // READ, WRITE, DELETE, APPROVE
  description String?
  
  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

// ABAC Limits
model UserRoleLimit {
  id        String   @id @default(uuid())
  userId    String
  module    String   // e.g. "PURCHASE_ORDER"
  limitType String   // AMOUNT, WAREHOUSE_ID
  limitValue String  // "10000", "WH-001"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------
// 0.5 Global Settings Engine
// --------------------------------------

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   // STRING, BOOLEAN, JSON
  group     String?  // SYSTEM, FINANCE, UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------
// 0.6 Audit Logs (System Wide)
// --------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, APPROVE
  module      String   // USER, INVOICE, SETTINGS
  entityId    String?  // ID of the record being verified
  beforeState Json?    // Snapshot before change
  afterState  Json?    // Snapshot after change
  ipAddress   String?
  userAgent   String?
  
  user        User?    @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}

// --------------------------------------
// 1.1 Chart of Accounts (COA)
// --------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  type      AccountType
  parentId  String?
  level     Int         @default(0)
  isPosting Boolean     @default(true) // Leaf node check
  
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountHierarchy")

  // Linkages
  productsInventory Product[] @relation("InventoryAccount")
  productsCOGS      Product[] @relation("COGSAccount")
  productsSales     Product[] @relation("SalesAccount")
  productsPurchase  Product[] @relation("PurchaseAccount")

  customersReceivable Customer[] @relation("ReceivableAccount")
  suppliersPayable    Supplier[] @relation("PayableAccount")
  journalLines        JournalLine[]
  taxCodes            TaxCode[] @relation("TaxAccount")

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

// --------------------------------------
// 1.2 Party Masters
// --------------------------------------

model Customer {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  taxId               String?
  currencyCode        String
  creditLimit         Decimal  @default(0.0)
  receivableAccountId String?

  currency            Currency @relation(fields: [currencyCode], references: [code])
  receivableAccount   Account? @relation("ReceivableAccount", fields: [receivableAccountId], references: [id])

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  quotes         SalesQuotation[]
  orders         SalesOrder[]
  deliveryOrders DeliveryOrder[]
  invoices       SalesInvoice[]
  returns        SalesReturn[]
}

model Supplier {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  taxId            String?
  currencyCode     String
  payableAccountId String?

  currency         Currency @relation(fields: [currencyCode], references: [code])
  payableAccount   Account? @relation("PayableAccount", fields: [payableAccountId], references: [id])

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  purchaseOrders  PurchaseOrder[]
  grns            GRN[]
  invoices        PurchaseInvoice[]
}

// --------------------------------------
// 1.4 Category & Sub-Category
// --------------------------------------

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

// --------------------------------------
// 1.3 Product Master (Accounting Linked)
// --------------------------------------

model Product {
  id                String   @id @default(uuid())
  code              String   @unique // SKU
  name              String
  categoryId        String?
  baseUnitId        String
  taxCodeId         String?
  
  // Ledger Mapping
  inventoryAccountId String?
  cogsAccountId      String?
  salesAccountId     String?
  purchaseAccountId  String?
  
  openingStock      Decimal  @default(0.0)

  category          Category? @relation(fields: [categoryId], references: [id])
  baseUnit          Unit      @relation(fields: [baseUnitId], references: [id])
  taxCode           TaxCode?  @relation(fields: [taxCodeId], references: [id])
  
  inventoryAccount  Account?  @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  cogsAccount       Account?  @relation("COGSAccount", fields: [cogsAccountId], references: [id])
  salesAccount      Account?  @relation("SalesAccount", fields: [salesAccountId], references: [id])
  purchaseAccount   Account?  @relation("PurchaseAccount", fields: [purchaseAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stockEntries       StockLedger[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems           GRNItem[]
  invoiceItems       PurchaseInvoiceItem[]
  requestItems       PurchaseRequestItem[]

  quoteItems         SalesQuotationItem[]
  orderItems         SalesOrderItem[]
  doItems            DeliveryOrderItem[]
  salesInvoiceItems  SalesInvoiceItem[]
  returnItems        SalesReturnItem[]
}

// --------------------------------------
// 1.5 Warehouse Master
// --------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  isDefault Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stockEntries    StockLedger[]
  purchaseOrders  PurchaseOrder[]
  grns            GRN[]

  deliveryOrders  DeliveryOrder[]
  salesInvoices   SalesInvoice[]
  salesOrders     SalesOrder[]
}

// --------------------------------------
// 1.7 Unit Conversion
// --------------------------------------

model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal  // Multiply 'from' by factor to get 'to'

  fromUnit   Unit     @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit     @relation("ToUnit", fields: [toUnitId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// --------------------------------------
// 2.1 General Ledger (Accounting Entries)
// --------------------------------------

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  PURCHASE
  SALES
  CONTRA
  PURCHASE_RETURN
  SALES_RETURN
  OPENING
  CLOSING
}

model JournalEntry {
  id              String       @id @default(uuid())
  number          String       @unique // Voucher Number
  date            DateTime
  type            VoucherType
  reference       String?      // Reference Doc No
  narration       String?
  status          Boolean      @default(true) // Posted/Draft
  financialYearId String?

  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])
  lines           JournalLine[]
  purchaseInvoice PurchaseInvoice?
  salesInvoice    SalesInvoice?
  salesReturn     SalesReturn?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  accountId   String
  debit       Decimal      @default(0.0)
  credit      Decimal      @default(0.0)
  narration   String?

  entry       JournalEntry @relation(fields: [entryId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
}

// --------------------------------------
// 2.2 Inventory Transactions (Stock Ledger)
// --------------------------------------

model StockLedger {
  id          String       @id @default(uuid())
  productId   String
  warehouseId String
  date        DateTime
  qtyIn       Decimal      @default(0.0)
  qtyOut      Decimal      @default(0.0)
  costRate    Decimal      @default(0.0)
  refType     String       // GRN, INVOICE, RETURN, ADJUSTMENT
  refId       String       // ID of the reference document

  product     Product      @relation(fields: [productId], references: [id])
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  
  createdAt   DateTime     @default(now())
}

// --------------------------------------
// 3.1 Purchase Module
// --------------------------------------

model PurchaseOrder {
  id            String             @id @default(uuid())
  poNo          String             @unique
  supplierId    String
  warehouseId   String
  date          DateTime
  expectedDate  DateTime?
  totalAmount   Decimal            @default(0.0)
  status        String             @default("DRAFT") // DRAFT, OPEN, CLOSED, CANCELLED

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         PurchaseOrderItem[]
  grns          GRN[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PurchaseOrderItem {
  id            String             @id @default(uuid())
  poId          String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  po            PurchaseOrder      @relation(fields: [poId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
  grnItems       GRNItem[]
}

model GRN {
  id            String             @id @default(uuid())
  grnNo         String             @unique
  poId          String?
  supplierId    String
  warehouseId   String
  date          DateTime
  remarks       String?

  po            PurchaseOrder?     @relation(fields: [poId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         GRNItem[]
  invoices      PurchaseInvoice[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model GRNItem {
  id            String             @id @default(uuid())
  grnId         String
  productId     String
  poItemId      String?
  qtyReceived   Decimal
  qtyRejected   Decimal            @default(0.0)

  grn           GRN                @relation(fields: [grnId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  poItem        PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
}

model PurchaseInvoice {
  id            String             @id @default(uuid())
  invoiceNo     String             @unique
  supplierId    String
  date          DateTime
  dueDate       DateTime?
  totalAmount   Decimal
  taxAmount     Decimal            @default(0.0)
  grnId         String?
  poId          String?
  journalEntryId String?           @unique

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  grn           GRN?               @relation(fields: [grnId], references: [id])
  journalEntry  JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  items         PurchaseInvoiceItem[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PurchaseInvoiceItem {
  id            String             @id @default(uuid())
  invoiceId     String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  invoice       PurchaseInvoice    @relation(fields: [invoiceId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
}

// --------------------------------------
// 3.2 Purchase Request
// --------------------------------------

model PurchaseRequest {
  id            String             @id @default(uuid())
  reqNo         String             @unique
  date          DateTime
  status        String             @default("DRAFT") // DRAFT, APPROVED, REJECTED, PO_CREATED
  remarks       String?
  
  items         PurchaseRequestItem[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PurchaseRequestItem {
  id            String             @id @default(uuid())
  requestId     String
  productId     String
  qty           Decimal
  description   String?

  request       PurchaseRequest    @relation(fields: [requestId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
}

// --------------------------------------
// 4.1 Sales Module
// --------------------------------------

model SalesQuotation {
  id            String             @id @default(uuid())
  quoteNo       String             @unique
  customerId    String
  date          DateTime
  validUntil    DateTime?
  totalAmount   Decimal            @default(0.0)
  status        String             @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED

  customer      Customer           @relation(fields: [customerId], references: [id])
  items         SalesQuotationItem[]
  orders        SalesOrder[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SalesQuotationItem {
  id            String             @id @default(uuid())
  quoteId       String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  quote         SalesQuotation     @relation(fields: [quoteId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
}

model SalesOrder {
  id            String             @id @default(uuid())
  orderNo       String             @unique
  customerId    String
  warehouseId   String?
  date          DateTime
  expectedDate  DateTime?
  totalAmount   Decimal            @default(0.0)
  status        String             @default("DRAFT") // DRAFT, OPEN, CLOSED, CANCELLED
  quoteId       String?

  customer      Customer           @relation(fields: [customerId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  quote         SalesQuotation?    @relation(fields: [quoteId], references: [id])
  items         SalesOrderItem[]
  deliveryOrders DeliveryOrder[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SalesOrderItem {
  id            String             @id @default(uuid())
  orderId       String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  order         SalesOrder         @relation(fields: [orderId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
  doItems       DeliveryOrderItem[]
}

model DeliveryOrder {
  id            String             @id @default(uuid())
  doNo          String             @unique
  orderId       String?
  customerId    String
  warehouseId   String
  date          DateTime
  remarks       String?

  order         SalesOrder?        @relation(fields: [orderId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  items         DeliveryOrderItem[]
  invoices      SalesInvoice[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model DeliveryOrderItem {
  id            String             @id @default(uuid())
  doId          String
  productId     String
  orderItemId   String?
  qtyShipped    Decimal
  qtyReturned   Decimal            @default(0.0)

  do            DeliveryOrder      @relation(fields: [doId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  orderItem     SalesOrderItem?    @relation(fields: [orderItemId], references: [id])
}

model SalesInvoice {
  id            String             @id @default(uuid())
  invoiceNo     String             @unique
  customerId    String
  warehouseId   String?
  date          DateTime
  dueDate       DateTime?
  totalAmount   Decimal
  taxAmount     Decimal            @default(0.0)
  doId          String?
  journalEntryId String?           @unique

  customer      Customer           @relation(fields: [customerId], references: [id])
  warehouse     Warehouse?         @relation(fields: [warehouseId], references: [id])
  do            DeliveryOrder?     @relation(fields: [doId], references: [id])
  journalEntry  JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  items         SalesInvoiceItem[]
  returns       SalesReturn[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SalesInvoiceItem {
  id            String             @id @default(uuid())
  invoiceId     String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  invoice       SalesInvoice       @relation(fields: [invoiceId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
}

model SalesReturn {
  id            String             @id @default(uuid())
  returnNo      String             @unique
  invoiceId     String
  customerId    String
  date          DateTime
  totalAmount   Decimal
  taxAmount     Decimal            @default(0.0)
  journalEntryId String?           @unique
  remarks       String?

  invoice       SalesInvoice       @relation(fields: [invoiceId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  journalEntry  JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  items         SalesReturnItem[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model SalesReturnItem {
  id            String             @id @default(uuid())
  returnId      String
  productId     String
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal            @default(0.0)
  total         Decimal

  return        SalesReturn        @relation(fields: [returnId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  taxCode       TaxCode?           @relation(fields: [taxCodeId], references: [id])
}

model VoucherSequence {
  id        String      @id @default(uuid())
  type      VoucherType @unique
  prefix    String
  nextValue Int         @default(1)

  updatedAt DateTime    @updatedAt
}
