generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// COMPANY & USER MANAGEMENT
// ============================================================

model Company {
  id           String        @id @default(uuid())
  name         String
  address      String?
  phone        String?
  email        String?
  website      String?
  logo         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  // Relations
  accounts         Account[]
  transactions     Transaction[]
  users            User[]
  userCompanies    UserCompany[]
  products         Product[]
  categories       Category[]
  customers        Customer[]
  suppliers        Supplier[]
  warehouses       Warehouse[]
  units            Unit[]
  currencies       Currency[]
  unitConversions  UnitConversion[]
  taxCodes         TaxCode[]
  financialYears   FinancialYear[]
  journalEntries   JournalEntry[]
  stockLedgers     StockLedger[]
  voucherSequences VoucherSequence[]
  companySettings  CompanySetting[]
  auditLogs        AuditLog[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  grns             GRN[]
  purchaseInvoices PurchaseInvoice[]
  purchaseRequests PurchaseRequest[]
  salesQuotations  SalesQuotation[]
  salesOrders      SalesOrder[]
  deliveryOrders   DeliveryOrder[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  roles            Role[]
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      String   @default("USER")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  fullName       String?
  isActive       Boolean       @default(true)
  isSuperAdmin   Boolean       @default(false)
  lastLoginAt    DateTime?
  mustChangePass Boolean       @default(true)
  passwordHash   String
  phone          String?
  updatedAt      DateTime      @updatedAt
  companyId      String?
  auditLogs      AuditLog[]
  company        Company?      @relation(fields: [companyId], references: [id])
  roles          UserRole[]
  companies      UserCompany[]
}

// ============================================================
// RBAC (Per Company)
// ============================================================

model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  companyId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRoleLimit {
  id         String   @id @default(uuid())
  userId     String
  module     String
  limitType  String
  limitValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// SETTINGS & CONFIG (Per Company)
// ============================================================

model CompanySetting {
  id        String   @id @default(uuid())
  companyId String
  key       String
  value     String
  type      String
  group     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  companyId   String?
  action      String
  module      String
  entityId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])
}

// ============================================================
// FINANCIAL YEAR (Per Company)
// ============================================================

model FinancialYear {
  id             String         @id @default(uuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isOpen         Boolean        @default(false)
  openKeyHash    String?
  lockedAt       DateTime?
  companyId      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  company        Company        @relation(fields: [companyId], references: [id])
  journalEntries JournalEntry[]

  @@unique([companyId, name])
}

// ============================================================
// MASTER DATA (Per Company)
// ============================================================

model Currency {
  id        String     @id @default(uuid())
  code      String
  name      String
  symbol    String
  rate      Decimal    @default(1.0)
  isBase    Boolean    @default(false)
  companyId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  company   Company    @relation(fields: [companyId], references: [id])
  customers Customer[]
  suppliers Supplier[]

  @@unique([companyId, code])
}

model Unit {
  id              String           @id @default(uuid())
  name            String
  code            String
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  company         Company          @relation(fields: [companyId], references: [id])
  products        Product[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  poItems         PurchaseOrderItem[]
  grnItems        GRNItem[]
  invoiceItems    PurchaseInvoiceItem[]
  returnItems     PurchaseReturnItem[]
  salesQuoteItems SalesQuotationItem[]
  salesOrderItems SalesOrderItem[]
  doItems         DeliveryOrderItem[]
  salesInvItems   SalesInvoiceItem[]
  salesRetItems   SalesReturnItem[]

  @@unique([companyId, code])
}

model TaxCode {
  id                   String                @id @default(uuid())
  name                 String
  code                 String
  rate                 Decimal               @default(0.0)
  companyId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  accountId            String?
  company              Company               @relation(fields: [companyId], references: [id])
  products             Product[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesOrderItems      SalesOrderItem[]
  salesQuotationItems  SalesQuotationItem[]
  salesReturnItems     SalesReturnItem[]
  account              Account?              @relation("TaxAccount", fields: [accountId], references: [id])

  @@unique([companyId, code])
}

model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String
  toUnitId   String
  factor     Decimal
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])
  fromUnit   Unit     @relation("FromUnit", fields: [fromUnitId], references: [id])
  toUnit     Unit     @relation("ToUnit", fields: [toUnitId], references: [id])
}

// ============================================================
// CHART OF ACCOUNTS (Per Company — already had companyId)
// ============================================================

model Account {
  id                  String         @id @default(uuid())
  code                String
  name                String
  type                AccountType
  parentId            String?
  level               Int            @default(0)
  isPosting           Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  companyId           String?
  description         String?
  openingBalance      Decimal        @default(0.0)
  openingBalanceType  String?
  company             Company?       @relation(fields: [companyId], references: [id])
  parent              Account?       @relation("AccountHierarchy", fields: [parentId], references: [id])
  children            Account[]      @relation("AccountHierarchy")
  entries             AccountEntry[]
  customersReceivable Customer[]     @relation("ReceivableAccount")
  journalLines        JournalLine[]
  productsCOGS        Product[]      @relation("COGSAccount")
  productsInventory   Product[]      @relation("InventoryAccount")
  productsPurchase    Product[]      @relation("PurchaseAccount")
  productsSales       Product[]      @relation("SalesAccount")
  suppliersPayable    Supplier[]     @relation("PayableAccount")
  taxCodes            TaxCode[]      @relation("TaxAccount")

  @@unique([companyId, code])
}

model Transaction {
  id          String         @id @default(uuid())
  reference   String
  date        DateTime       @default(now())
  description String?
  type        String         @default("JOURNAL")
  invoiceId   String?
  paymentId   String?
  purchaseId  String?
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isLocked    Boolean        @default(false)
  entries     AccountEntry[]
  company     Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
}

model AccountEntry {
  id            String      @id @default(uuid())
  transactionId String
  accountId     String
  debit         Decimal     @default(0.0)
  credit        Decimal     @default(0.0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  account       Account     @relation(fields: [accountId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

// ============================================================
// PARTIES (Per Company)
// ============================================================

model Customer {
  id                  String           @id @default(uuid())
  code                String
  name                String
  taxId               String?
  currencyCode        String
  creditLimit         Decimal          @default(0.0)
  receivableAccountId String?
  companyId           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  company             Company          @relation(fields: [companyId], references: [id])
  currency            Currency         @relation(fields: [currencyCode], references: [id])
  receivableAccount   Account?         @relation("ReceivableAccount", fields: [receivableAccountId], references: [id])
  deliveryOrders      DeliveryOrder[]
  invoices            SalesInvoice[]
  orders              SalesOrder[]
  quotes              SalesQuotation[]
  returns             SalesReturn[]

  @@unique([companyId, code])
}

model Supplier {
  id               String            @id @default(uuid())
  code             String
  name             String
  taxId            String?
  currencyCode     String
  payableAccountId String?
  companyId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  grns             GRN[]
  invoices         PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  returns          PurchaseReturn[]
  currency         Currency          @relation(fields: [currencyCode], references: [id])
  payableAccount   Account?          @relation("PayableAccount", fields: [payableAccountId], references: [id])

  @@unique([companyId, code])
}

// ============================================================
// INVENTORY (Per Company)
// ============================================================

model Category {
  id        String     @id @default(uuid())
  name      String
  parentId  String?
  companyId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  company   Company    @relation(fields: [companyId], references: [id])
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Product {
  id                  String                @id @default(uuid())
  code                String
  name                String
  categoryId          String?
  baseUnitId          String
  taxCodeId           String?
  inventoryAccountId  String?
  cogsAccountId       String?
  salesAccountId      String?
  purchaseAccountId   String?
  openingStock        Decimal               @default(0.0)
  companyId           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  company             Company               @relation(fields: [companyId], references: [id])
  doItems             DeliveryOrderItem[]
  grnItems            GRNItem[]
  baseUnit            Unit                  @relation(fields: [baseUnitId], references: [id])
  category            Category?             @relation(fields: [categoryId], references: [id])
  cogsAccount         Account?              @relation("COGSAccount", fields: [cogsAccountId], references: [id])
  inventoryAccount    Account?              @relation("InventoryAccount", fields: [inventoryAccountId], references: [id])
  purchaseAccount     Account?              @relation("PurchaseAccount", fields: [purchaseAccountId], references: [id])
  salesAccount        Account?              @relation("SalesAccount", fields: [salesAccountId], references: [id])
  taxCode             TaxCode?              @relation(fields: [taxCodeId], references: [id])
  variants            ProductVariant[]
  invoiceItems        PurchaseInvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  requestItems        PurchaseRequestItem[]
  purchaseReturnItems PurchaseReturnItem[]
  salesInvoiceItems   SalesInvoiceItem[]
  orderItems          SalesOrderItem[]
  quoteItems          SalesQuotationItem[]
  returnItems         SalesReturnItem[]
  stockEntries        StockLedger[]

  @@unique([companyId, code])
}

model ProductVariant {
  id           String        @id @default(uuid())
  productId    String
  name         String
  sku          String?       @unique
  price        Decimal?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockEntries StockLedger[]

  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  grnItems            GRNItem[]
  invoiceItems         PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesQuotationItems  SalesQuotationItem[]
  salesOrderItems      SalesOrderItem[]
  deliveryOrderItems   DeliveryOrderItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
}

model Warehouse {
  id               String            @id @default(uuid())
  code             String
  name             String
  address          String?
  isDefault        Boolean           @default(false)
  companyId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  deliveryOrders   DeliveryOrder[]
  grns             GRN[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  salesInvoices    SalesInvoice[]
  salesOrders      SalesOrder[]
  salesReturns     SalesReturn[]
  stockEntries     StockLedger[]

  @@unique([companyId, code])
}

// ============================================================
// JOURNAL & ACCOUNTING (Per Company)
// ============================================================

model JournalEntry {
  id              String           @id @default(uuid())
  number          String
  date            DateTime
  type            VoucherType
  reference       String?
  narration       String?
  status          Boolean          @default(true)
  companyId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  financialYearId String?
  company         Company          @relation(fields: [companyId], references: [id])
  financialYear   FinancialYear?   @relation(fields: [financialYearId], references: [id])
  lines           JournalLine[]
  purchaseInvoice PurchaseInvoice?
  purchaseReturn  PurchaseReturn?
  salesInvoice    SalesInvoice?
  salesReturn     SalesReturn?

  @@unique([companyId, number])
}

model JournalLine {
  id        String       @id @default(uuid())
  entryId   String
  accountId String
  debit     Decimal      @default(0.0)
  credit    Decimal      @default(0.0)
  narration String?
  account   Account      @relation(fields: [accountId], references: [id])
  entry     JournalEntry @relation(fields: [entryId], references: [id])
}

model StockLedger {
  id          String          @id @default(uuid())
  productId   String
  warehouseId String
  date        DateTime
  qtyIn       Decimal         @default(0.0)
  qtyOut      Decimal         @default(0.0)
  costRate    Decimal         @default(0.0)
  refType     String
  refId       String
  companyId   String
  createdAt   DateTime        @default(now())
  variantId   String?
  company     Company         @relation(fields: [companyId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
}

// ============================================================
// PURCHASE MODULE (Per Company)
// ============================================================

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNo         String
  supplierId   String
  warehouseId  String?
  date         DateTime
  expectedDate DateTime?
  totalAmount  Decimal             @default(0.0)
  status       String              @default("DRAFT")
  companyId    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id])
  grns         GRN[]
  invoices     PurchaseInvoice[]
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse?          @relation(fields: [warehouseId], references: [id])
  items        PurchaseOrderItem[]
  returns      PurchaseReturn[]

  @@unique([companyId, poNo])
}

model PurchaseReturn {
  id             String               @id @default(uuid())
  returnNo       String
  poId           String?
  invoiceId      String?
  supplierId     String
  warehouseId    String
  date           DateTime
  totalAmount    Decimal              @default(0.0)
  journalEntryId String?              @unique
  remarks        String?
  companyId      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id])
  invoice        PurchaseInvoice?     @relation(fields: [invoiceId], references: [id])
  journalEntry   JournalEntry?        @relation(fields: [journalEntryId], references: [id])
  po             PurchaseOrder?       @relation(fields: [poId], references: [id])
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  items          PurchaseReturnItem[]

  @@unique([companyId, returnNo])
}

model PurchaseReturnItem {
  id            String               @id @default(uuid())
  returnId      String
  productId     String
  variantId     String?
  invoiceItemId String?
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal              @default(0.0)
  total         Decimal
  invoiceItem   PurchaseInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  unitId        String?
  product       Product              @relation(fields: [productId], references: [id])
  variant       ProductVariant?      @relation(fields: [variantId], references: [id])
  return        PurchaseReturn       @relation(fields: [returnId], references: [id])
  taxCode       TaxCode?             @relation(fields: [taxCodeId], references: [id])
  unit          Unit?                @relation(fields: [unitId], references: [id])
}

model PurchaseOrderItem {
  id           String                @id @default(uuid())
  poId         String
  productId    String
  variantId    String?
  qty          Decimal
  rate         Decimal
  taxCodeId    String?
  taxAmount    Decimal               @default(0.0)
  total        Decimal
  invoicedQty  Decimal               @default(0.0)
  receivedQty  Decimal               @default(0.0)
  grnItems     GRNItem[]
  invoiceItems PurchaseInvoiceItem[]
  unitId       String?
  po           PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id])
  variant      ProductVariant?       @relation(fields: [variantId], references: [id])
  taxCode      TaxCode?              @relation(fields: [taxCodeId], references: [id])
  unit         Unit?                 @relation(fields: [unitId], references: [id])
}

model GRN {
  id          String            @id @default(uuid())
  grnNo       String
  poId        String?
  supplierId  String
  warehouseId String
  date        DateTime
  remarks     String?
  companyId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id])
  po          PurchaseOrder?    @relation(fields: [poId], references: [id])
  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  items       GRNItem[]
  invoices    PurchaseInvoice[]

  @@unique([companyId, grnNo])
}

model GRNItem {
  id          String             @id @default(uuid())
  grnId       String
  productId   String
  variantId   String?
  poItemId    String?
  qtyReceived Decimal
  qtyRejected Decimal            @default(0.0)
  rate        Decimal            @default(0.0)
  unitId      String?
  grn         GRN                @relation(fields: [grnId], references: [id])
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  product     Product            @relation(fields: [productId], references: [id])
  variant     ProductVariant?    @relation(fields: [variantId], references: [id])
  unit        Unit?              @relation(fields: [unitId], references: [id])
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  invoiceNo      String
  supplierId     String
  date           DateTime
  dueDate        DateTime?
  totalAmount    Decimal
  taxAmount      Decimal               @default(0.0)
  grnId          String?
  poId           String?
  journalEntryId String?               @unique
  companyId      String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  warehouseId    String?
  company        Company               @relation(fields: [companyId], references: [id])
  grn            GRN?                  @relation(fields: [grnId], references: [id])
  journalEntry   JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  po             PurchaseOrder?        @relation(fields: [poId], references: [id])
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse?            @relation(fields: [warehouseId], references: [id])
  items          PurchaseInvoiceItem[]
  returns        PurchaseReturn[]

  @@unique([companyId, invoiceNo])
}

model PurchaseInvoiceItem {
  id          String               @id @default(uuid())
  invoiceId   String
  productId   String
  variantId   String?
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal              @default(0.0)
  total         Decimal
  grnItemId     String?
  poItemId      String?
  unitId        String?
  invoice       PurchaseInvoice      @relation(fields: [invoiceId], references: [id])
  poItem        PurchaseOrderItem?   @relation(fields: [poItemId], references: [id])
  product       Product              @relation(fields: [productId], references: [id])
  variant       ProductVariant?      @relation(fields: [variantId], references: [id])
  taxCode       TaxCode?             @relation(fields: [taxCodeId], references: [id])
  returnItems   PurchaseReturnItem[]
  unit          Unit?                @relation(fields: [unitId], references: [id])
}

model PurchaseRequest {
  id        String                @id @default(uuid())
  reqNo     String
  date      DateTime
  status    String                @default("DRAFT")
  remarks   String?
  companyId String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id])
  items     PurchaseRequestItem[]

  @@unique([companyId, reqNo])
}

model PurchaseRequestItem {
  id          String          @id @default(uuid())
  requestId   String
  productId   String
  variantId   String?
  qty         Decimal
  description String?
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  request     PurchaseRequest @relation(fields: [requestId], references: [id])
}

// ============================================================
// SALES MODULE (Per Company)
// ============================================================

model SalesQuotation {
  id          String               @id @default(uuid())
  quoteNo     String
  customerId  String
  date        DateTime
  validUntil  DateTime?
  totalAmount Decimal              @default(0.0)
  status      String               @default("DRAFT")
  companyId   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id])
  orders      SalesOrder[]
  customer    Customer             @relation(fields: [customerId], references: [id])
  items       SalesQuotationItem[]

  @@unique([companyId, quoteNo])
}

model SalesQuotationItem {
  id        String         @id @default(uuid())
  quoteId   String
  productId String
  variantId String?
  qty       Decimal
  rate      Decimal
  taxCodeId String?
  taxAmount Decimal        @default(0.0)
  total     Decimal
  unitId    String?
  unit      Unit?          @relation(fields: [unitId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quote     SalesQuotation @relation(fields: [quoteId], references: [id])
  taxCode   TaxCode?       @relation(fields: [taxCodeId], references: [id])
}

model SalesOrder {
  id             String           @id @default(uuid())
  orderNo        String
  customerId     String
  warehouseId    String?
  date           DateTime
  expectedDate   DateTime?
  totalAmount    Decimal          @default(0.0)
  status         String           @default("DRAFT")
  quoteId        String?
  companyId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id])
  deliveryOrders DeliveryOrder[]
  invoices       SalesInvoice[]
  customer       Customer         @relation(fields: [customerId], references: [id])
  quote          SalesQuotation?  @relation(fields: [quoteId], references: [id])
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id])
  items          SalesOrderItem[]

  @@unique([companyId, orderNo])
}

model SalesOrderItem {
  id           String              @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  qty          Decimal
  rate         Decimal
  taxCodeId    String?
  taxAmount    Decimal             @default(0.0)
  total        Decimal
  fulfilledQty Decimal             @default(0.0)
  invoicedQty  Decimal             @default(0.0)
  doItems      DeliveryOrderItem[]
  invoiceItems SalesInvoiceItem[]
  unitId       String?
  unit         Unit?               @relation(fields: [unitId], references: [id])
  order        SalesOrder          @relation(fields: [orderId], references: [id])
  product      Product             @relation(fields: [productId], references: [id])
  variant      ProductVariant?     @relation(fields: [variantId], references: [id])
  taxCode      TaxCode?            @relation(fields: [taxCodeId], references: [id])
}

model DeliveryOrder {
  id          String              @id @default(uuid())
  doNo        String
  orderId     String?
  customerId  String
  warehouseId String
  date        DateTime
  remarks     String?
  companyId   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id])
  customer    Customer            @relation(fields: [customerId], references: [id])
  order       SalesOrder?         @relation(fields: [orderId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       DeliveryOrderItem[]
  invoices    SalesInvoice[]

  @@unique([companyId, doNo])
}

model DeliveryOrderItem {
  id        String          @id @default(uuid())
  doId      String
  productId String
  variantId String?
  qty       Decimal
  soItemId  String?
  unitId    String?
  unit      Unit?           @relation(fields: [unitId], references: [id])
  do        DeliveryOrder   @relation(fields: [doId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  soItem    SalesOrderItem? @relation(fields: [soItemId], references: [id])
}

model SalesInvoice {
  id             String             @id @default(uuid())
  invoiceNo      String
  customerId     String
  warehouseId    String?
  date           DateTime
  dueDate        DateTime?
  totalAmount    Decimal
  taxAmount      Decimal            @default(0.0)
  doId           String?
  journalEntryId String?            @unique
  companyId      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  orderId        String?
  company        Company            @relation(fields: [companyId], references: [id])
  customer       Customer           @relation(fields: [customerId], references: [id])
  do             DeliveryOrder?     @relation(fields: [doId], references: [id])
  journalEntry   JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  order          SalesOrder?        @relation(fields: [orderId], references: [id])
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id])
  items          SalesInvoiceItem[]
  returns        SalesReturn[]

  @@unique([companyId, invoiceNo])
}

model SalesInvoiceItem {
  id          String            @id @default(uuid())
  invoiceId   String
  productId   String
  variantId   String?
  qty         Decimal
  rate        Decimal
  taxCodeId   String?
  taxAmount   Decimal           @default(0.0)
  total       Decimal
  doItemId    String?
  soItemId    String?
  unitId      String?
  unit        Unit?             @relation(fields: [unitId], references: [id])
  invoice     SalesInvoice      @relation(fields: [invoiceId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])
  variant     ProductVariant?   @relation(fields: [variantId], references: [id])
  soItem      SalesOrderItem?   @relation(fields: [soItemId], references: [id])
  taxCode     TaxCode?          @relation(fields: [taxCodeId], references: [id])
  returnItems SalesReturnItem[]
}

model SalesReturn {
  id             String            @id @default(uuid())
  returnNo       String
  invoiceId      String?
  customerId     String
  date           DateTime
  totalAmount    Decimal           @default(0.0)
  journalEntryId String?           @unique
  remarks        String?
  companyId      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  warehouseId    String
  company        Company           @relation(fields: [companyId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  invoice        SalesInvoice?     @relation(fields: [invoiceId], references: [id])
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  items          SalesReturnItem[]

  @@unique([companyId, returnNo])
}

model SalesReturnItem {
  id            String            @id @default(uuid())
  returnId      String
  productId     String
  variantId     String?
  qty           Decimal
  rate          Decimal
  taxCodeId     String?
  taxAmount     Decimal           @default(0.0)
  total         Decimal
  invoiceItemId String?
  unitId        String?
  unit          Unit?             @relation(fields: [unitId], references: [id])
  invoiceItem   SalesInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  return        SalesReturn       @relation(fields: [returnId], references: [id])
  taxCode       TaxCode?          @relation(fields: [taxCodeId], references: [id])
}

// ============================================================
// VOUCHER SEQUENCE (Per Company)
// ============================================================

model VoucherSequence {
  id        String      @id @default(uuid())
  type      VoucherType
  prefix    String
  nextValue Int         @default(1)
  companyId String
  updatedAt DateTime    @updatedAt
  company   Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, type])
}

// ============================================================
// ENUMS
// ============================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum BalanceType {
  DR
  CR
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  PURCHASE
  SALES
  CONTRA
  PURCHASE_RETURN
  SALES_RETURN
  OPENING
  CLOSING
}
